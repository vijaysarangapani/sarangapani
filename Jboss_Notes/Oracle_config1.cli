connect localhost:10090
batch
module add --name=com.oracle --resources=F:\Softwares\Oracle\ojdbc6.jar --dependencies=javax.api,javax.transaction.api

/subsystem=datasources/jdbc-driver=oracle:add(driver-name=oracle,driver-module-name=com.oracle)

data-source add --jndi-name=java:/Oracle_Amazon_CLI --name=Oracle_Amazon_CLI  --connection-url=jdbc:oracle:thin:@localhost:1521:xe --driver-name=oracle --user-name=system --password=admin

deploy F:\Softwares\sampleapplications\Calendar.war



run-batch